[
  {
    "kernelSource": {
      "name": "Xiaomi_Kernel_OpenSource-chopin-r-oss",
      "repo": "https://github.com/MiCode/Xiaomi_Kernel_OpenSource",
      "branch": "chopin-r-oss",
      "device": "chopin",
      "defconfig": "chopin_user_defconfig"
    },
    "withKernelSU": false,
    "toolchains": [
      {
        "name": "system-clang",
        "binPath": ["/usr/bin"]
      }
    ],
    "ccache": true,
    "params": {
      "ARCH": "arm64",
      "CC": "clang",
      "externalCommand": {
        "CROSS_COMPILE": "aarch64-linux-gnu-",
        "CROSS_COMPILE_ARM32": "arm-linux-gnueabi-",
        "LD": "ld.lld",
        "AR": "llvm-ar",
        "NM": "llvm-nm",
        "OBJCOPY": "llvm-objcopy",
        "OBJDUMP": "llvm-objdump",
        "READELF": "llvm-readelf",
        "OBJSIZE": "llvm-size",
        "STRIP": "llvm-strip",
        "LLVM_AR": "llvm-ar",
        "LLVM_DIS": "llvm-dis"
      }
    },
    "AnyKernel3": {
      "use": false,
      "release": false,
      "repo": "https://github.com/osm0sis/AnyKernel3",
      "branch": "master"
    }
  }
]